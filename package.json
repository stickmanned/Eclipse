{
  "name": "eclipse",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Chrome extension that swaps words on pages you already read, at the level you can handle.",
  "scripts": {
    "build:words": "tsx data/build-wordlist.ts",
    "probe": "tsx scripts/probe.ts",
    "sim": "tsx bench/simulate.ts",
    "tune": "tsx bench/tune.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "build": "node build.mjs",
    "watch": "node build.mjs --watch",
    "ablate": "tsx bench/ablate.ts",
    "smoke": "tsx scripts/smoke.ts"
  },
  "dependencies": {
    "ts-fsrs": "^4.7.1"
  },
  "devDependencies": {
    "@types/chrome": "^0.0.287",
    "@types/node": "^22.10.2",
    "esbuild": "^0.28.1",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2",
    "vitest": "^2.1.8"
  }
}
