{
  "manifest_version": 3,
  "name": "Eclipse",
  "version": "0.1.0",
  "description": "Swaps words on the pages you already read, at the level you can handle.",
  "permissions": ["storage", "activeTab", "scripting"],
  "host_permissions": ["https://ai.hackclub.com/*", "<all_urls>"],
  "background": { "service_worker": "background.js", "type": "module" },
  "action": { "default_popup": "popup.html", "default_title": "Eclipse" },
  "options_page": "options.html",
  "content_scripts": [
    {
      "matches": ["<all_urls>"],
      "js": ["content.js"],
      "run_at": "document_idle"
    }
  ]
}
