# Eclipse — optional local generation API only.
#
# The Chrome extension NEVER reads this file and NEVER embeds a key.
# Everything in Eclipse works with the deterministic French catalog and no network
# access at all. This file only configures `npm run api`, the optional localhost
# server that can propose additional context traps.
#
# Copy to `.env` and fill in if — and only if — you want the optional provider.
# `.env` is gitignored. Do not commit a real key.

# Port the optional generation API listens on. Must match the extension's
# optional host permission (http://localhost:8787/*).
ECLIPSE_API_PORT=8787

# Which provider implementation to use. The server also selects Gemini when a
# key is present and this field is omitted. Use "disabled" for catalog-only.
ECLIPSE_PROVIDER=gemini

# API key for the optional provider. Leave empty to keep the provider disabled.
GEMINI_API_KEY=replace-with-your-gemini-api-key

# Native Gemini model used for generation.
GEMINI_MODEL=gemini-3.5-flash-lite

# Comma-separated origin allowlist. This Chrome-extension-scoped wildcard
# accepts only well-formed 32-letter extension IDs; broad web wildcards remain
# invalid. Replace it with one exact chrome-extension://<id> origin if desired.
ECLIPSE_ALLOWED_ORIGINS=chrome-extension://*
